{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: calidad A0",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tool/quality.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: APK DEV debug",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--debug",
        "--flavor",
        "dev",
        "-t",
        "lib/main_dev.dart"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
