-- Bitacora RPG Personal - persistence schema (v4; v1 base, see ADRs 001 and 006).
-- Source of truth: ADR-001-CONTRATO_PERSISTENCIA_V1.md.
-- All *_at columns store Unix epoch milliseconds in UTC.

CREATE TABLE life_areas (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  icon_key TEXT NOT NULL,
  color_hex TEXT NOT NULL CHECK (
    color_hex GLOB '#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]'
  ),
  is_default INTEGER NOT NULL CHECK (is_default IN (0, 1)),
  is_visible INTEGER NOT NULL DEFAULT 1 CHECK (is_visible IN (0, 1)),
  sort_order INTEGER NOT NULL CHECK (sort_order >= 0),
  archived_at INTEGER
);

CREATE UNIQUE INDEX uq_life_areas_active_name
  ON life_areas(name COLLATE NOCASE)
  WHERE archived_at IS NULL;

CREATE UNIQUE INDEX uq_life_areas_default_active
  ON life_areas(is_default)
  WHERE is_default = 1 AND archived_at IS NULL;

CREATE TABLE mission_templates (
  id TEXT NOT NULL PRIMARY KEY,
  area_id TEXT NOT NULL REFERENCES life_areas(id) ON DELETE RESTRICT,
  title TEXT NOT NULL CHECK (length(trim(title)) BETWEEN 1 AND 160),
  description TEXT,
  mission_type TEXT NOT NULL CHECK (mission_type IN (
    'PRIMARY',
    'SECONDARY',
    'ERRAND',
    'DAILY',
    'RECURRING',
    'EVENT',
    'CHALLENGE',
    'CUSTOM'
  )),
  importance TEXT NOT NULL DEFAULT 'NORMAL' CHECK (importance IN (
    'MINOR',
    'NORMAL',
    'IMPORTANT',
    'VERY_IMPORTANT',
    'CRITICAL'
  )),
  priority TEXT NOT NULL DEFAULT 'NORMAL' CHECK (priority IN (
    'LOW',
    'NORMAL',
    'HIGH',
    'URGENT'
  )),
  difficulty TEXT CHECK (difficulty IS NULL OR difficulty IN (
    'EASY',
    'MEDIUM',
    'HARD'
  )),
  is_required INTEGER NOT NULL CHECK (is_required IN (0, 1)),
  xp_reward INTEGER NOT NULL CHECK (xp_reward >= 0),
  estimated_minutes INTEGER CHECK (
    estimated_minutes IS NULL OR estimated_minutes > 0
  ),
  budget_minor INTEGER CHECK (budget_minor IS NULL OR budget_minor >= 0),
  availability_mode TEXT NOT NULL DEFAULT 'AUTOMATIC' CHECK (
    availability_mode IN ('AUTOMATIC', 'BOARD')
  ),
  is_active INTEGER NOT NULL CHECK (is_active IN (0, 1)),
  location TEXT CHECK (
    location IS NULL OR length(trim(location)) BETWEEN 1 AND 120
  )
);

CREATE TABLE mission_template_objectives (
  id TEXT NOT NULL PRIMARY KEY,
  template_id TEXT NOT NULL
    REFERENCES mission_templates(id) ON DELETE CASCADE,
  description TEXT NOT NULL CHECK (
    length(trim(description)) BETWEEN 1 AND 240
  ),
  position INTEGER NOT NULL CHECK (position >= 0),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  row_version INTEGER NOT NULL DEFAULT 1 CHECK (row_version >= 1),
  UNIQUE (template_id, position)
);

CREATE TABLE recurrence_rules (
  id TEXT NOT NULL PRIMARY KEY,
  template_id TEXT NOT NULL UNIQUE
    REFERENCES mission_templates(id) ON DELETE CASCADE,
  frequency TEXT NOT NULL CHECK (frequency IN (
    'DAILY',
    'WEEKLY',
    'SPECIFIC_DAYS',
    'EVERY_N_DAYS'
  )),
  interval_value INTEGER NOT NULL CHECK (interval_value >= 1),
  weekdays_mask INTEGER,
  local_time_minutes INTEGER CHECK (
    local_time_minutes IS NULL OR local_time_minutes BETWEEN 0 AND 1439
  ),
  start_date TEXT NOT NULL CHECK (
    length(start_date) = 10
    AND start_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
    AND date(start_date) IS NOT NULL
    AND date(start_date) = start_date
  ),
  end_date TEXT CHECK (
    end_date IS NULL
    OR (
      length(end_date) = 10
      AND end_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
      AND date(end_date) IS NOT NULL
      AND date(end_date) = end_date
      AND end_date >= start_date
    )
  ),
  timezone_id TEXT NOT NULL,
  last_generated_on TEXT CHECK (
    last_generated_on IS NULL
    OR (
      length(last_generated_on) = 10
      AND last_generated_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
      AND date(last_generated_on) IS NOT NULL
      AND date(last_generated_on) = last_generated_on
    )
  ),
  CHECK (
    (frequency = 'SPECIFIC_DAYS' AND weekdays_mask BETWEEN 1 AND 127)
    OR (frequency <> 'SPECIFIC_DAYS' AND weekdays_mask IS NULL)
  )
);

CREATE TABLE missions (
  id TEXT NOT NULL PRIMARY KEY,
  template_id TEXT REFERENCES mission_templates(id) ON DELETE SET NULL,
  area_id TEXT NOT NULL REFERENCES life_areas(id) ON DELETE RESTRICT,
  title TEXT NOT NULL CHECK (length(trim(title)) BETWEEN 1 AND 160),
  description TEXT,
  mission_type TEXT NOT NULL CHECK (mission_type IN (
    'PRIMARY',
    'SECONDARY',
    'ERRAND',
    'DAILY',
    'RECURRING',
    'EVENT',
    'CHALLENGE',
    'CUSTOM'
  )),
  importance TEXT NOT NULL DEFAULT 'NORMAL' CHECK (importance IN (
    'MINOR',
    'NORMAL',
    'IMPORTANT',
    'VERY_IMPORTANT',
    'CRITICAL'
  )),
  priority TEXT NOT NULL DEFAULT 'NORMAL' CHECK (priority IN (
    'LOW',
    'NORMAL',
    'HIGH',
    'URGENT'
  )),
  difficulty TEXT CHECK (difficulty IS NULL OR difficulty IN (
    'EASY',
    'MEDIUM',
    'HARD'
  )),
  is_required INTEGER NOT NULL CHECK (is_required IN (0, 1)),
  status TEXT NOT NULL CHECK (status IN (
    'DRAFT',
    'SCHEDULED',
    'AVAILABLE',
    'ACTIVE',
    'PAUSED',
    'RESCHEDULED',
    'EXPIRED',
    'ABANDONED',
    'CANCELLED',
    'PARTIAL',
    'COMPLETED'
  )),
  scheduled_at INTEGER,
  available_from INTEGER,
  expires_at INTEGER,
  estimated_minutes INTEGER CHECK (
    estimated_minutes IS NULL OR estimated_minutes > 0
  ),
  budget_minor INTEGER CHECK (budget_minor IS NULL OR budget_minor >= 0),
  xp_planned INTEGER NOT NULL CHECK (xp_planned >= 0),
  actual_result TEXT,
  convenience_rating TEXT CHECK (
    convenience_rating IS NULL OR convenience_rating IN (
      'TOTALLY_WORTH_IT',
      'WORTH_IT_BUT_COSTLY',
      'PARTIALLY_WORTH_IT',
      'BARELY_WORTH_IT',
      'WOULD_NOT_REPEAT'
    )
  ),
  completed_at INTEGER,
  archived_at INTEGER,
  row_version INTEGER NOT NULL DEFAULT 1 CHECK (row_version >= 1),
  location TEXT CHECK (
    location IS NULL OR length(trim(location)) BETWEEN 1 AND 120
  ),
  CHECK (
    (status IN ('COMPLETED', 'PARTIAL') AND completed_at IS NOT NULL)
    OR
    (status NOT IN ('COMPLETED', 'PARTIAL') AND completed_at IS NULL)
  ),
  CHECK (
    available_from IS NULL
    OR scheduled_at IS NULL
    OR available_from <= scheduled_at
  ),
  CHECK (
    scheduled_at IS NULL
    OR expires_at IS NULL
    OR scheduled_at <= expires_at
  ),
  CHECK (
    available_from IS NULL
    OR expires_at IS NULL
    OR available_from <= expires_at
  )
);

CREATE UNIQUE INDEX uq_occurrence
  ON missions(template_id, scheduled_at)
  WHERE template_id IS NOT NULL;

CREATE INDEX idx_missions_status_date
  ON missions(status, scheduled_at);

CREATE INDEX idx_missions_area_date
  ON missions(area_id, scheduled_at);

CREATE TABLE mission_objectives (
  id TEXT NOT NULL PRIMARY KEY,
  mission_id TEXT NOT NULL REFERENCES missions(id) ON DELETE RESTRICT,
  description TEXT NOT NULL CHECK (
    length(trim(description)) BETWEEN 1 AND 240
  ),
  position INTEGER NOT NULL CHECK (position >= 0),
  completed_at INTEGER,
  created_at INTEGER NOT NULL,
  UNIQUE (mission_id, position)
);

CREATE TABLE time_entries (
  id TEXT NOT NULL PRIMARY KEY,
  mission_id TEXT NOT NULL REFERENCES missions(id) ON DELETE RESTRICT,
  source TEXT NOT NULL CHECK (source IN ('TIMER', 'MANUAL')),
  segment_type TEXT NOT NULL CHECK (segment_type IN ('WORK', 'BREAK')),
  started_at INTEGER,
  ended_at INTEGER,
  duration_seconds INTEGER NOT NULL CHECK (duration_seconds >= 0),
  note TEXT,
  created_at INTEGER NOT NULL,
  CHECK (ended_at IS NULL OR started_at IS NULL OR ended_at >= started_at)
);

CREATE INDEX idx_time_mission_start
  ON time_entries(mission_id, started_at);

CREATE UNIQUE INDEX uq_time_open_timer_work
  ON time_entries(mission_id)
  WHERE source = 'TIMER'
    AND segment_type = 'WORK'
    AND ended_at IS NULL;

CREATE TABLE mission_events (
  id TEXT NOT NULL PRIMARY KEY,
  mission_id TEXT NOT NULL REFERENCES missions(id) ON DELETE RESTRICT,
  event_type TEXT NOT NULL CHECK (event_type IN (
    'CREATED',
    'UPDATED',
    'AVAILABLE',
    'STARTED',
    'PAUSED',
    'RESUMED',
    'RESCHEDULED',
    'EXPIRED',
    'ABANDONED',
    'CANCELLED',
    'PARTIALLY_COMPLETED',
    'COMPLETED',
    'CORRECTED',
    'ARCHIVED'
  )),
  from_status TEXT CHECK (from_status IS NULL OR from_status IN (
    'DRAFT',
    'SCHEDULED',
    'AVAILABLE',
    'ACTIVE',
    'PAUSED',
    'RESCHEDULED',
    'EXPIRED',
    'ABANDONED',
    'CANCELLED',
    'PARTIAL',
    'COMPLETED'
  )),
  to_status TEXT CHECK (to_status IS NULL OR to_status IN (
    'DRAFT',
    'SCHEDULED',
    'AVAILABLE',
    'ACTIVE',
    'PAUSED',
    'RESCHEDULED',
    'EXPIRED',
    'ABANDONED',
    'CANCELLED',
    'PARTIAL',
    'COMPLETED'
  )),
  reason TEXT,
  snapshot_json TEXT,
  occurred_at INTEGER NOT NULL
);

CREATE INDEX idx_event_mission_time
  ON mission_events(mission_id, occurred_at);

CREATE TABLE notification_schedules (
  id TEXT NOT NULL PRIMARY KEY,
  mission_id TEXT NOT NULL REFERENCES missions(id) ON DELETE RESTRICT,
  notification_type TEXT NOT NULL CHECK (notification_type IN (
    'EARLY',
    'PREPARATION',
    'START',
    'FOLLOW_UP',
    'CRITICAL'
  )),
  notify_at INTEGER NOT NULL,
  status TEXT NOT NULL CHECK (status IN (
    'PENDING',
    'SCHEDULED',
    'FIRED',
    'CANCELLED',
    'FAILED'
  )),
  system_notification_id INTEGER,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE (mission_id, notification_type, notify_at)
);

CREATE INDEX idx_notification_due
  ON notification_schedules(status, notify_at);

CREATE TABLE transactions (
  id TEXT NOT NULL PRIMARY KEY,
  operation_id TEXT NOT NULL UNIQUE,
  mission_id TEXT REFERENCES missions(id) ON DELETE SET NULL,
  related_transaction_id TEXT REFERENCES transactions(id) ON DELETE RESTRICT,
  transaction_type TEXT NOT NULL CHECK (transaction_type IN (
    'INCOME',
    'EXPENSE',
    'REFUND',
    'ADJUSTMENT_CREDIT',
    'ADJUSTMENT_DEBIT'
  )),
  amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
  payment_method TEXT CHECK (
    payment_method IS NULL OR payment_method IN ('CASH', 'BANK', 'WALLET')
  ),
  category TEXT,
  note TEXT,
  occurred_at INTEGER NOT NULL,
  created_at INTEGER NOT NULL,
  reversed_at INTEGER CHECK (
    reversed_at IS NULL OR reversed_at >= occurred_at
  )
);

CREATE INDEX idx_tx_date_type
  ON transactions(occurred_at, transaction_type);

CREATE INDEX idx_transactions_mission
  ON transactions(mission_id);

CREATE INDEX idx_transactions_related
  ON transactions(related_transaction_id);

CREATE TABLE savings_goals (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL CHECK (length(trim(title)) BETWEEN 1 AND 160),
  target_minor INTEGER NOT NULL CHECK (target_minor > 0),
  status TEXT NOT NULL CHECK (status IN (
    'ACTIVE',
    'ACHIEVED',
    'PAUSED',
    'ARCHIVED'
  )),
  due_date TEXT CHECK (
    due_date IS NULL
    OR (
      length(due_date) = 10
      AND due_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
      AND date(due_date) IS NOT NULL
      AND date(due_date) = due_date
    )
  ),
  created_at INTEGER NOT NULL,
  archived_at INTEGER
);

CREATE TABLE goal_allocations (
  id TEXT NOT NULL PRIMARY KEY,
  operation_id TEXT NOT NULL UNIQUE,
  goal_id TEXT NOT NULL REFERENCES savings_goals(id) ON DELETE RESTRICT,
  direction TEXT NOT NULL CHECK (direction IN ('RESERVE', 'RELEASE')),
  amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
  note TEXT,
  occurred_at INTEGER NOT NULL,
  created_at INTEGER NOT NULL
);

CREATE INDEX idx_goal_time
  ON goal_allocations(goal_id, occurred_at);

CREATE TABLE journal_entries (
  id TEXT NOT NULL PRIMARY KEY,
  origin_type TEXT NOT NULL CHECK (origin_type IN (
    'MANUAL',
    'MISSION',
    'TRANSACTION',
    'SYSTEM'
  )),
  mission_id TEXT REFERENCES missions(id) ON DELETE SET NULL,
  transaction_id TEXT REFERENCES transactions(id) ON DELETE SET NULL,
  title TEXT NOT NULL CHECK (length(trim(title)) BETWEEN 1 AND 160),
  body TEXT,
  mood TEXT CHECK (mood IS NULL OR mood IN ('FOCUSED', 'NORMAL', 'TIRED')),
  mood_detail TEXT CHECK (mood_detail IS NULL OR mood_detail IN (
    'HAPPY',
    'MOTIVATED',
    'FOCUSED',
    'CALM',
    'NORMAL',
    'ANXIOUS',
    'SAD',
    'TIRED'
  )),
  is_private INTEGER NOT NULL CHECK (is_private IN (0, 1)),
  occurred_at INTEGER NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  archived_at INTEGER
);

CREATE INDEX idx_journal_time
  ON journal_entries(occurred_at);

CREATE INDEX idx_journal_mission
  ON journal_entries(mission_id);

CREATE INDEX idx_journal_transaction
  ON journal_entries(transaction_id);

CREATE TABLE journal_attachments (
  id TEXT NOT NULL PRIMARY KEY,
  journal_entry_id TEXT NOT NULL
    REFERENCES journal_entries(id) ON DELETE CASCADE,
  kind TEXT NOT NULL CHECK (kind = 'PHOTO'),
  storage_name TEXT NOT NULL UNIQUE,
  mime_type TEXT NOT NULL CHECK (mime_type IN (
    'image/jpeg',
    'image/png',
    'image/webp'
  )),
  byte_length INTEGER NOT NULL CHECK (byte_length > 0),
  cipher_sha256 TEXT NOT NULL CHECK (
    length(cipher_sha256) = 64
    AND cipher_sha256 NOT GLOB '*[^0-9a-f]*'
  ),
  width_px INTEGER NOT NULL CHECK (width_px > 0),
  height_px INTEGER NOT NULL CHECK (height_px > 0),
  position INTEGER NOT NULL CHECK (position >= 0),
  created_at INTEGER NOT NULL,
  archived_at INTEGER,
  UNIQUE (journal_entry_id, position)
);

CREATE TABLE xp_transactions (
  id TEXT NOT NULL PRIMARY KEY,
  area_id TEXT NOT NULL REFERENCES life_areas(id) ON DELETE RESTRICT,
  mission_id TEXT REFERENCES missions(id) ON DELETE RESTRICT,
  journal_entry_id TEXT REFERENCES journal_entries(id) ON DELETE SET NULL,
  source_type TEXT NOT NULL CHECK (source_type IN (
    'MISSION',
    'JOURNAL',
    'MANUAL_ADJUSTMENT'
  )),
  amount INTEGER NOT NULL CHECK (amount <> 0),
  reason TEXT,
  occurred_at INTEGER NOT NULL,
  CHECK (source_type = 'MANUAL_ADJUSTMENT' OR amount > 0),
  CHECK (
    source_type <> 'MANUAL_ADJUSTMENT'
    OR length(trim(reason)) > 0
  )
);

CREATE UNIQUE INDEX uq_xp_mission
  ON xp_transactions(mission_id)
  WHERE source_type = 'MISSION';

CREATE INDEX idx_xp_area_time
  ON xp_transactions(area_id, occurred_at);

CREATE INDEX idx_xp_time
  ON xp_transactions(occurred_at);

CREATE TABLE title_definitions (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  description TEXT,
  title_kind TEXT NOT NULL CHECK (title_kind IN (
    'PERMANENT',
    'DYNAMIC',
    'TEMPORARY'
  )),
  rule_key TEXT NOT NULL UNIQUE,
  threshold INTEGER CHECK (threshold IS NULL OR threshold >= 0),
  is_active INTEGER NOT NULL CHECK (is_active IN (0, 1))
);

CREATE TABLE title_history (
  id TEXT NOT NULL PRIMARY KEY,
  title_id TEXT NOT NULL
    REFERENCES title_definitions(id) ON DELETE RESTRICT,
  status TEXT NOT NULL CHECK (status IN ('ACTIVE', 'INACTIVE', 'EARNED')),
  activated_at INTEGER NOT NULL,
  deactivated_at INTEGER CHECK (
    deactivated_at IS NULL OR deactivated_at >= activated_at
  ),
  best_streak INTEGER NOT NULL DEFAULT 0 CHECK (best_streak >= 0),
  recovery_count INTEGER NOT NULL DEFAULT 0 CHECK (recovery_count >= 0)
);

CREATE INDEX idx_title_history_time
  ON title_history(title_id, activated_at);

CREATE UNIQUE INDEX uq_title_history_current
  ON title_history(title_id)
  WHERE deactivated_at IS NULL AND status IN ('ACTIVE', 'EARNED');

CREATE TABLE app_settings (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  theme_key TEXT NOT NULL,
  primary_color TEXT NOT NULL CHECK (
    primary_color GLOB '#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]'
  ),
  large_text INTEGER NOT NULL CHECK (large_text IN (0, 1)),
  reduce_motion INTEGER NOT NULL CHECK (reduce_motion IN (0, 1)),
  high_contrast INTEGER NOT NULL CHECK (high_contrast IN (0, 1)),
  hide_amounts INTEGER NOT NULL CHECK (hide_amounts IN (0, 1)),
  mission_notifications INTEGER NOT NULL CHECK (
    mission_notifications IN (0, 1)
  ),
  daily_summary INTEGER NOT NULL CHECK (daily_summary IN (0, 1)),
  sound_enabled INTEGER NOT NULL CHECK (sound_enabled IN (0, 1)),
  auto_lock_minutes INTEGER NOT NULL CHECK (auto_lock_minutes >= 0),
  updated_at INTEGER NOT NULL
);

CREATE TABLE schema_metadata (
  "key" TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL,
  updated_at INTEGER NOT NULL
);

-- ADR-006 (schema v4): personajes, inventario, proyectos y creacion.

CREATE TABLE contacts (
  id TEXT NOT NULL PRIMARY KEY,
  display_name TEXT CHECK (
    display_name IS NULL OR length(trim(display_name)) BETWEEN 1 AND 80
  ),
  role TEXT CHECK (role IS NULL OR length(trim(role)) BETWEEN 1 AND 80),
  description TEXT CHECK (description IS NULL OR length(description) <= 4000),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  archived_at INTEGER,
  row_version INTEGER NOT NULL DEFAULT 1 CHECK (row_version >= 1)
);

CREATE TABLE contact_photos (
  id TEXT NOT NULL PRIMARY KEY,
  contact_id TEXT NOT NULL REFERENCES contacts(id) ON DELETE RESTRICT,
  storage_name TEXT NOT NULL UNIQUE,
  mime_type TEXT NOT NULL CHECK (mime_type IN (
    'image/jpeg', 'image/png', 'image/webp'
  )),
  byte_length INTEGER NOT NULL CHECK (byte_length > 0),
  cipher_sha256 TEXT NOT NULL CHECK (
    length(cipher_sha256) = 64 AND cipher_sha256 NOT GLOB '*[^0-9a-f]*'
  ),
  width_px INTEGER NOT NULL CHECK (width_px > 0),
  height_px INTEGER NOT NULL CHECK (height_px > 0),
  created_at INTEGER NOT NULL,
  archived_at INTEGER
);

CREATE UNIQUE INDEX uq_contact_photo_current
  ON contact_photos(contact_id) WHERE archived_at IS NULL;

CREATE TABLE mission_contacts (
  mission_id TEXT NOT NULL REFERENCES missions(id) ON DELETE CASCADE,
  contact_id TEXT NOT NULL REFERENCES contacts(id) ON DELETE RESTRICT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (mission_id, contact_id)
);

CREATE INDEX idx_mission_contacts_contact ON mission_contacts(contact_id);

CREATE TABLE journal_entry_contacts (
  journal_entry_id TEXT NOT NULL
    REFERENCES journal_entries(id) ON DELETE CASCADE,
  contact_id TEXT NOT NULL REFERENCES contacts(id) ON DELETE RESTRICT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (journal_entry_id, contact_id)
);

CREATE INDEX idx_journal_contacts_contact ON journal_entry_contacts(contact_id);

CREATE TABLE mission_photos (
  id TEXT NOT NULL PRIMARY KEY,
  mission_id TEXT NOT NULL REFERENCES missions(id) ON DELETE RESTRICT,
  storage_name TEXT NOT NULL UNIQUE,
  mime_type TEXT NOT NULL CHECK (mime_type IN (
    'image/jpeg', 'image/png', 'image/webp'
  )),
  byte_length INTEGER NOT NULL CHECK (byte_length > 0),
  cipher_sha256 TEXT NOT NULL CHECK (
    length(cipher_sha256) = 64 AND cipher_sha256 NOT GLOB '*[^0-9a-f]*'
  ),
  width_px INTEGER NOT NULL CHECK (width_px > 0),
  height_px INTEGER NOT NULL CHECK (height_px > 0),
  created_at INTEGER NOT NULL,
  archived_at INTEGER
);

CREATE UNIQUE INDEX uq_mission_photo_current
  ON mission_photos(mission_id) WHERE archived_at IS NULL;

CREATE TABLE inventory_items (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 120),
  description TEXT CHECK (description IS NULL OR length(description) <= 4000),
  category TEXT NOT NULL CHECK (category IN (
    'TECHNOLOGY', 'CLOTHING', 'ACCESSORY', 'BOOK', 'PART', 'HOME', 'OTHER'
  )),
  icon_key TEXT NOT NULL CHECK (length(icon_key) BETWEEN 1 AND 64),
  color_hex TEXT CHECK (
    color_hex IS NULL OR color_hex GLOB
    '#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]'
  ),
  status TEXT NOT NULL CHECK (status IN (
    'WISHED', 'OWNED', 'INTEGRATED', 'RETIRED'
  )),
  origin TEXT CHECK (origin IS NULL OR origin IN (
    'PURCHASE', 'GIFT', 'PREEXISTING', 'ASSEMBLED'
  )),
  body_zone TEXT CHECK (body_zone IS NULL OR body_zone IN (
    'HEAD', 'EYES', 'EARS', 'TORSO', 'LEGS', 'FEET',
    'WRIST', 'HANDS', 'BACK', 'DEVICE'
  )),
  is_equipped INTEGER NOT NULL DEFAULT 0 CHECK (is_equipped IN (0, 1)),
  purchase_transaction_id TEXT UNIQUE
    REFERENCES transactions(id) ON DELETE RESTRICT,
  parent_item_id TEXT REFERENCES inventory_items(id) ON DELETE RESTRICT,
  wish_priority TEXT CHECK (wish_priority IS NULL OR wish_priority IN (
    'LOW', 'MEDIUM', 'HIGH'
  )),
  wish_price_minor INTEGER CHECK (
    wish_price_minor IS NULL OR wish_price_minor > 0
  ),
  wish_goal_id TEXT REFERENCES savings_goals(id) ON DELETE SET NULL,
  acquired_at INTEGER,
  retired_at INTEGER,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  archived_at INTEGER,
  row_version INTEGER NOT NULL DEFAULT 1 CHECK (row_version >= 1),
  CHECK ((status = 'WISHED') = (wish_priority IS NOT NULL)),
  CHECK (status <> 'WISHED' OR (origin IS NULL AND acquired_at IS NULL)),
  CHECK (status = 'WISHED' OR (origin IS NOT NULL AND acquired_at IS NOT NULL)),
  CHECK (is_equipped = 0 OR (status = 'OWNED' AND body_zone IS NOT NULL)),
  CHECK ((status = 'INTEGRATED') = (parent_item_id IS NOT NULL)),
  CHECK ((status = 'RETIRED') = (retired_at IS NOT NULL)),
  CHECK (purchase_transaction_id IS NULL OR origin = 'PURCHASE'),
  CHECK (parent_item_id IS NULL OR parent_item_id <> id)
);

CREATE INDEX idx_items_status_category ON inventory_items(status, category);

CREATE INDEX idx_items_equipped_zone
  ON inventory_items(body_zone) WHERE is_equipped = 1;

CREATE INDEX idx_items_parent ON inventory_items(parent_item_id);

CREATE TABLE item_photos (
  id TEXT NOT NULL PRIMARY KEY,
  item_id TEXT NOT NULL REFERENCES inventory_items(id) ON DELETE RESTRICT,
  storage_name TEXT NOT NULL UNIQUE,
  mime_type TEXT NOT NULL CHECK (mime_type IN (
    'image/jpeg', 'image/png', 'image/webp'
  )),
  byte_length INTEGER NOT NULL CHECK (byte_length > 0),
  cipher_sha256 TEXT NOT NULL CHECK (
    length(cipher_sha256) = 64 AND cipher_sha256 NOT GLOB '*[^0-9a-f]*'
  ),
  width_px INTEGER NOT NULL CHECK (width_px > 0),
  height_px INTEGER NOT NULL CHECK (height_px > 0),
  created_at INTEGER NOT NULL,
  archived_at INTEGER
);

CREATE UNIQUE INDEX uq_item_photo_current
  ON item_photos(item_id) WHERE archived_at IS NULL;

CREATE TABLE projects (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 120),
  description TEXT CHECK (description IS NULL OR length(description) <= 4000),
  icon_key TEXT NOT NULL CHECK (length(icon_key) BETWEEN 1 AND 64),
  kind TEXT NOT NULL CHECK (kind IN ('ASSEMBLY', 'COLLECTION')),
  status TEXT NOT NULL CHECK (status IN (
    'PLANNING', 'COMPLETED', 'ASSEMBLED', 'DISASSEMBLED'
  )),
  mission_id TEXT UNIQUE REFERENCES missions(id) ON DELETE SET NULL,
  result_item_id TEXT UNIQUE REFERENCES inventory_items(id) ON DELETE RESTRICT,
  completed_at INTEGER,
  disassembled_at INTEGER,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  archived_at INTEGER,
  row_version INTEGER NOT NULL DEFAULT 1 CHECK (row_version >= 1),
  CHECK (kind = 'ASSEMBLY' OR status IN ('PLANNING', 'COMPLETED')),
  CHECK (kind = 'COLLECTION' OR status <> 'COMPLETED'),
  CHECK (kind = 'ASSEMBLY' OR result_item_id IS NULL),
  CHECK ((status = 'PLANNING') = (completed_at IS NULL)),
  CHECK ((status IN ('ASSEMBLED', 'DISASSEMBLED')) = (result_item_id IS NOT NULL)),
  CHECK ((status = 'DISASSEMBLED') = (disassembled_at IS NOT NULL))
);

CREATE TABLE project_items (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
  owner_type TEXT NOT NULL CHECK (owner_type IN ('SELF', 'CONTACT', 'OTHER')),
  item_id TEXT REFERENCES inventory_items(id) ON DELETE RESTRICT,
  contact_id TEXT REFERENCES contacts(id) ON DELETE RESTRICT,
  owner_name TEXT CHECK (
    owner_name IS NULL OR length(trim(owner_name)) BETWEEN 1 AND 80
  ),
  label TEXT CHECK (label IS NULL OR length(trim(label)) BETWEEN 1 AND 120),
  position INTEGER NOT NULL CHECK (position >= 0),
  created_at INTEGER NOT NULL,
  CHECK ((owner_type = 'SELF') = (item_id IS NOT NULL)),
  CHECK ((owner_type = 'CONTACT') = (contact_id IS NOT NULL)),
  CHECK ((owner_type = 'OTHER') = (owner_name IS NOT NULL)),
  CHECK (owner_type = 'SELF' OR label IS NOT NULL),
  UNIQUE (project_id, position)
);

CREATE INDEX idx_project_items_item ON project_items(item_id);

CREATE INDEX idx_project_items_contact ON project_items(contact_id);

CREATE TABLE craft_operations (
  id TEXT NOT NULL PRIMARY KEY,
  operation_id TEXT NOT NULL UNIQUE,
  kind TEXT NOT NULL CHECK (kind IN (
    'MISSION_GRANT', 'CONVERT', 'REDEEM', 'ABANDON_REFUND',
    'ASSEMBLE', 'DISASSEMBLE', 'PROJECT_COMPLETE'
  )),
  mission_id TEXT REFERENCES missions(id) ON DELETE RESTRICT,
  occurred_at INTEGER NOT NULL,
  CHECK ((kind = 'MISSION_GRANT') = (mission_id IS NOT NULL))
);

CREATE UNIQUE INDEX uq_craft_mission_grant
  ON craft_operations(mission_id) WHERE kind = 'MISSION_GRANT';

CREATE TABLE craft_component_ledger (
  id TEXT NOT NULL PRIMARY KEY,
  craft_operation_id TEXT NOT NULL
    REFERENCES craft_operations(id) ON DELETE RESTRICT,
  rarity TEXT NOT NULL CHECK (rarity IN (
    'COMMON', 'UNCOMMON', 'RARE', 'EPIC', 'LEGENDARY'
  )),
  amount INTEGER NOT NULL CHECK (amount <> 0),
  UNIQUE (craft_operation_id, rarity)
);

CREATE INDEX idx_craft_ledger_rarity ON craft_component_ledger(rarity);

CREATE TABLE reward_specs (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 120),
  description TEXT CHECK (description IS NULL OR length(description) <= 2000),
  icon_key TEXT NOT NULL CHECK (length(icon_key) BETWEEN 1 AND 64),
  is_repeatable INTEGER NOT NULL DEFAULT 1 CHECK (is_repeatable IN (0, 1)),
  unlock_level INTEGER CHECK (unlock_level IS NULL OR unlock_level >= 1),
  target_item_id TEXT REFERENCES inventory_items(id) ON DELETE SET NULL,
  target_project_id TEXT REFERENCES projects(id) ON DELETE SET NULL,
  created_at INTEGER NOT NULL,
  archived_at INTEGER,
  CHECK (target_item_id IS NULL OR target_project_id IS NULL)
);

CREATE TABLE reward_spec_costs (
  reward_spec_id TEXT NOT NULL
    REFERENCES reward_specs(id) ON DELETE CASCADE,
  rarity TEXT NOT NULL CHECK (rarity IN (
    'COMMON', 'UNCOMMON', 'RARE', 'EPIC', 'LEGENDARY'
  )),
  quantity INTEGER NOT NULL CHECK (quantity > 0),
  PRIMARY KEY (reward_spec_id, rarity)
);

CREATE TABLE reward_vouchers (
  id TEXT NOT NULL PRIMARY KEY,
  reward_spec_id TEXT NOT NULL
    REFERENCES reward_specs(id) ON DELETE RESTRICT,
  redeem_operation_id TEXT NOT NULL UNIQUE
    REFERENCES craft_operations(id) ON DELETE RESTRICT,
  refund_operation_id TEXT UNIQUE
    REFERENCES craft_operations(id) ON DELETE RESTRICT,
  status TEXT NOT NULL CHECK (status IN ('AVAILABLE', 'USED', 'ABANDONED')),
  journal_entry_id TEXT REFERENCES journal_entries(id) ON DELETE SET NULL,
  redeemed_at INTEGER NOT NULL,
  used_at INTEGER,
  abandoned_at INTEGER,
  CHECK ((status = 'USED') = (used_at IS NOT NULL)),
  CHECK ((status = 'ABANDONED') = (abandoned_at IS NOT NULL)),
  CHECK ((status = 'ABANDONED') = (refund_operation_id IS NOT NULL))
);

CREATE INDEX idx_vouchers_status ON reward_vouchers(status, redeemed_at);
